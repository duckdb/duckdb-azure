# name: test/sql/azure_directory_scope_azurite.test
# description: a COPY to a directory works when only the secret scoped to '<dir>/' has valid credentials
# group: [sql]

require azure

require-env AZ_TEMP_DIR

require-env AZURE_STORAGE_CONNECTION_STRING

# The parent secret fails before a request goes out (the account key is not base64)
statement ok
CREATE SECRET parent_broken (
    TYPE AZURE,
    SCOPE 'az://{AZ_TEMP_DIR}/dirscope/',
    CONNECTION_STRING 'AccountName=devstoreaccount1;AccountKey=not-base64-!!!'
)

statement ok
CREATE SECRET dir_ok (
    TYPE AZURE,
    SCOPE 'az://{AZ_TEMP_DIR}/dirscope/dir/',
    CONNECTION_STRING '{AZURE_STORAGE_CONNECTION_STRING}'
)

# The directory check, the listing and the file writes all use the '<dir>/' secret
statement ok
COPY (SELECT 1 AS id) TO 'az://{AZ_TEMP_DIR}/dirscope/dir' (FORMAT csv, PER_THREAD_OUTPUT);

statement error
COPY (SELECT 1 AS id) TO 'az://{AZ_TEMP_DIR}/dirscope/dir' (FORMAT csv, PER_THREAD_OUTPUT);
----
is not empty

statement ok
COPY (SELECT 2 AS id) TO 'az://{AZ_TEMP_DIR}/dirscope/dir' (FORMAT csv, PER_THREAD_OUTPUT, OVERWRITE);

query I
SELECT sum(id) FROM read_csv('az://{AZ_TEMP_DIR}/dirscope/dir/*.csv');
----
2

# A blob named '<dir>' is a file and takes the parent scope
statement error
SELECT * FROM read_csv('az://{AZ_TEMP_DIR}/dirscope/dir', columns = {'id': 'INTEGER'});
----
Unexpected end of Base64 encoded string
