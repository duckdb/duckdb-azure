# name: test/sql/azure_secret_refresh.test
# description: credential_chain secrets with REFRESH 'auto' carry a bearer token
# group: [sql]

require azure

statement error
CREATE SECRET s1 (TYPE AZURE, PROVIDER CREDENTIAL_CHAIN, CHAIN 'cli', REFRESH 'manual')
----
Unsupported value 'manual' for 'refresh', only 'auto' is supported

# Without REFRESH the chain is only resolved when a file is opened
statement ok
CREATE SECRET s1 (TYPE AZURE, PROVIDER CREDENTIAL_CHAIN, CHAIN 'bogus')

statement ok
DROP SECRET s1

# With REFRESH 'auto' the chain is resolved when the secret is created
statement error
CREATE SECRET s1 (TYPE AZURE, PROVIDER CREDENTIAL_CHAIN, CHAIN 'bogus', REFRESH 'auto')
----
Unknown credential provider found: bogus
