# name: test/sql/azure_connection_string_azurite.test
# description: Exercise connection-string formats against Azurite
# group: [sql]

require azure

require-env AZURE_PROVIDER local

require-env AZURE_STORAGE_CONNECTION_STRING

require-env AZ_TEMP_DIR

test-env AZURITE_SHORTCUT_PROXY direct

# These fixtures use Azurite's public test key, never a production credential.
# Explicit endpoints override the default protocol and sovereign-cloud suffix.
foreach connection_string AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:28000/devstoreaccount1;DfsEndpoint=http://127.0.0.1:28000/devstoreaccount1 DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:28000/devstoreaccount1;DfsEndpoint=http://127.0.0.1:28000/devstoreaccount1;EndpointSuffix=core.chinacloudapi.cn defaultendpointsprotocol=HTTPS;blobendpoint=http://127.0.0.1:28000/devstoreaccount1;dfsendpoint=http://127.0.0.1:28000/devstoreaccount1;accountkey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;accountname=devstoreaccount1;EndpointSuffix=core.usgovcloudapi.net;FileEndpoint=https://devstoreaccount1.file.core.windows.net;QueueEndpoint=http://127.0.0.1:28001/devstoreaccount1;TableEndpoint=http://127.0.0.1:28002/devstoreaccount1;

statement ok
CREATE SECRET connection_string_test (
    TYPE AZURE,
    CONNECTION_STRING '{connection_string}'
);

foreach prefix az:// azure:// abfs:// abfss://

query I
SELECT count(*) FROM '{prefix}testing-private/l.csv';
----
60175

query I
SELECT count(*) FROM '{prefix}devstoreaccount1.blob.core.windows.net/testing-private/l.csv';
----
60175

endloop

statement ok
DROP SECRET connection_string_test;

statement ok
SET azure_storage_connection_string = '{connection_string}';

foreach prefix az:// azure://

query I
SELECT count(*) FROM '{prefix}testing-private/l.csv';
----
60175

query I
SELECT count(*) FROM '{prefix}devstoreaccount1.blob.core.windows.net/testing-private/l.csv';
----
60175

endloop

endloop

statement ok
SET azure_storage_connection_string = '';

# Preserve '=' padding in shared keys while normalizing surrounding whitespace.
statement ok
CREATE SECRET connection_string_test (
    TYPE AZURE,
    CONNECTION_STRING ' AccountName = devstoreaccount1 ; AccountKey = Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw== ; BlobEndpoint = http://127.0.0.1:28000/devstoreaccount1 ; '
);

query I
SELECT count(*) FROM 'az://devstoreaccount1.blob.core.windows.net/testing-private/l.csv';
----
60175

statement ok
DROP SECRET connection_string_test;

# Account SAS and container SAS tokens are signed with Azurite's public key and expire in 2099.
# The container SAS also exercises an optional leading '?' and URL-encoded signature characters.
foreach sas sv=2021-10-04&ss=b&srt=sco&sp=rl&se=2099-12-31T23:59:59Z&sig=ZvYeIxR2gf4n72jD9c02gpQXEV%2BhHBoK5eBxpxQTGOM%3D ?sv=2021-10-04&sr=c&sp=rl&se=2099-12-31T23:59:59Z&sig=MJBI5EjOW3G8F4i8djSU8RY6RaG9lJrKzKbwIoGUIfI%3D

statement ok
CREATE SECRET connection_string_test (
    TYPE AZURE,
    CONNECTION_STRING 'BlobEndpoint=http://127.0.0.1:28000/devstoreaccount1;DfsEndpoint=http://127.0.0.1:28000/devstoreaccount1;FileEndpoint=https://devstoreaccount1.file.core.windows.net;QueueEndpoint=http://127.0.0.1:28001/devstoreaccount1;TableEndpoint=http://127.0.0.1:28002/devstoreaccount1;SharedAccessSignature={sas}'
);

foreach prefix az:// azure:// abfs:// abfss://

query I
SELECT count(*) FROM '{prefix}testing-private/l.csv';
----
60175

query I
SELECT count(*) FROM '{prefix}127.0.0.1:28000/testing-private/l.csv';
----
60175

endloop

foreach prefix abfs:// abfss://

query I
SELECT count(*) FROM '{prefix}testing-private@127.0.0.1:28000/l.csv';
----
60175

endloop

foreach prefix az:// azure://

query I
SELECT count(*) FROM '{prefix}127.0.0.1:28000/testing-private/li*.csv';
----
60175

endloop

# Endpoint-only credentials must not be reused for another host or an explicit different port.
statement error
SELECT * FROM 'az://other.blob.core.windows.net/testing-private/l.csv';
----
The provided connection string does not match the storage account named other

statement error
SELECT * FROM 'az://127.0.0.1:28001/testing-private/l.csv';
----
The provided connection string does not match the storage account named 127

# AccountName remains optional, but is honored when supplied with a SAS token.
statement ok
CREATE OR REPLACE SECRET connection_string_test (
    TYPE AZURE,
    CONNECTION_STRING 'AccountName=devstoreaccount1;BlobEndpoint=http://127.0.0.1:28000/devstoreaccount1;DfsEndpoint=http://127.0.0.1:28000/devstoreaccount1;SharedAccessSignature={sas}'
);

foreach prefix az:// azure:// abfs:// abfss://

query I
SELECT count(*) FROM '{prefix}devstoreaccount1.blob.core.windows.net/testing-private/l.csv';
----
60175

endloop

statement ok
DROP SECRET connection_string_test;

statement ok
SET azure_storage_connection_string = 'BlobEndpoint=http://127.0.0.1:28000/devstoreaccount1;DfsEndpoint=http://127.0.0.1:28000/devstoreaccount1;SharedAccessSignature={sas}';

foreach prefix az:// azure://

query I
SELECT count(*) FROM '{prefix}testing-private/l.csv';
----
60175

query I
SELECT count(*) FROM '{prefix}127.0.0.1:28000/testing-private/l.csv';
----
60175

endloop

endloop

statement ok
SET azure_storage_connection_string = '';

# Anonymous access also needs only an explicit endpoint.
statement ok
CREATE SECRET connection_string_test (
    TYPE AZURE,
    CONNECTION_STRING 'BlobEndpoint=http://127.0.0.1:28000/devstoreaccount1;DfsEndpoint=http://127.0.0.1:28000/devstoreaccount1'
);

foreach prefix az:// azure:// abfs:// abfss://

query I
SELECT count(*) FROM '{prefix}127.0.0.1:28000/testing-public/l.csv';
----
60175

endloop

statement ok
DROP SECRET connection_string_test;

# The shortcut must actually target the default Azurite endpoint, with its built-in credentials.
statement ok
CREATE SECRET connection_string_test (
    TYPE AZURE,
    CONNECTION_STRING 'UseDevelopmentStorage=true'
);

statement ok
COPY (SELECT 42 AS id) TO 'az://{AZ_TEMP_DIR}/connection-string-shortcut.csv';

statement ok
DROP SECRET connection_string_test;

# Like the Azure SDK's development-storage convention, the proxy URI supplies the host and
# scheme; its port and path are replaced by the emulator's default port and account path.
foreach connection_string UseDevelopmentStorage=true UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://127.0.0.1 usedevelopmentstorage=TRUE;developmentstorageproxyuri=http://127.0.0.1:28000/ignored

statement ok
CREATE SECRET connection_string_test (
    TYPE AZURE,
    CONNECTION_STRING '{connection_string}'
);

foreach prefix az:// azure:// abfs:// abfss://

query I
SELECT id FROM '{prefix}{AZ_TEMP_DIR}/connection-string-shortcut.csv';
----
42

query I
SELECT id FROM '{prefix}devstoreaccount1.blob.core.windows.net/{AZ_TEMP_DIR}/connection-string-shortcut.csv';
----
42

endloop

statement ok
DROP SECRET connection_string_test;

statement ok
SET azure_http_proxy = CASE WHEN '{AZURITE_SHORTCUT_PROXY}' = 'direct' THEN '' ELSE '{AZURITE_SHORTCUT_PROXY}' END;

statement ok
SET azure_storage_connection_string = '{connection_string}';

foreach prefix az:// azure://

query I
SELECT id FROM '{prefix}{AZ_TEMP_DIR}/connection-string-shortcut.csv';
----
42

query I
SELECT id FROM '{prefix}devstoreaccount1.blob.core.windows.net/{AZ_TEMP_DIR}/connection-string-shortcut.csv';
----
42

endloop

endloop

statement ok
SET azure_storage_connection_string = '';

statement ok
SET azure_http_proxy = '';
