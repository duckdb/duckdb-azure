# name: test/sql/cloud/credential_chain_refresh.test
# description: credential_chain secrets with REFRESH 'auto' carry a bearer token for other extensions
# group: [cloud]

require azure

require parquet

require-env AZURE_CLIENT_ID

require-env AZURE_CLIENT_SECRET

require-env AZURE_TENANT_ID

require-env AZ_STORAGE_ACCOUNT

require-env AZ_DATA_DIR

statement ok
set allow_persistent_secrets=false

statement ok
CREATE SECRET s1 (
    TYPE AZURE,
    PROVIDER CREDENTIAL_CHAIN,
    CHAIN 'env',
    REFRESH 'auto',
    ACCOUNT_NAME '{AZ_STORAGE_ACCOUNT}'
)

# The token and refresh_info are stored, and redacted
query II
SELECT regexp_matches(secret_string, 'token=redacted'), regexp_matches(secret_string, 'refresh_info=redacted')
FROM duckdb_secrets() WHERE name = 's1';
----
true	true

# The token expires in the future
query I
SELECT regexp_extract(secret_string, 'expiration_epoch_ms=(\d+)', 1)::BIGINT > epoch_ms(now())
FROM duckdb_secrets() WHERE name = 's1';
----
true

# The secret still works for storage access
query I
SELECT count(*) FROM 'azure://{AZ_DATA_DIR}/l.parquet';
----
60175
