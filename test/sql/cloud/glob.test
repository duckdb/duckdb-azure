# name: test/sql/cloud/glob.test
# group: [cloud]

require azure

require-env ABFSS_STORAGE_ACCOUNT

require-env ABFSS_DATA_DIR

require-env AZ_STORAGE_ACCOUNT

require-env AZ_DATA_DIR

require-env AZURE_AUTH_ENV 1

statement ok
CREATE SECRET az_authn (
    TYPE AZURE,
    PROVIDER CREDENTIAL_CHAIN,
    ACCOUNT_NAME '{AZ_STORAGE_ACCOUNT}',
	SCOPE 'az://'
);

statement ok
CREATE SECRET abfss_authn (
    TYPE AZURE,
    PROVIDER CREDENTIAL_CHAIN,
    ACCOUNT_NAME '{ABFSS_STORAGE_ACCOUNT}',
	SCOPE 'abfss://'
);


# Auto glob: "foo" -> "foo/**/*.csv" if foo doesn't exist via MF reader 
query II
SELECT l_shipmode, COUNT(*) 
FROM read_csv('az://{AZ_DATA_DIR}/partitioned') 
GROUP BY l_shipmode ORDER BY l_shipmode;
----
AIR	2318
SHIP	2301
TRUCK	2317

# DFS supports the same recursive fallback as Blob storage.
query II
SELECT l_shipmode, COUNT(*)
FROM read_csv('abfss://{ABFSS_DATA_DIR}/partitioned')
GROUP BY l_shipmode ORDER BY l_shipmode;
----
AIR	2318
SHIP	2301
TRUCK	2317

# A recursive component can match zero or multiple directory levels.
query I
SELECT file FROM glob('abfss://{ABFSS_DATA_DIR}/**/*.parquet');
----
abfss://{ABFSS_DATA_DIR}/l.parquet

foreach pattern **/l_shipmode=TRUCK/*.csv l_receipmonth=*/**/l_shipmode=TRUCK/*.csv l_receipmonth=*/l_shipmode=TRUCK/**/*.csv **/**/l_shipmode=TRUCK/*.csv

query I
SELECT count(*) FROM glob('abfss://{ABFSS_DATA_DIR}/partitioned/{pattern}');
----
2

endloop

# Adjacent stars inside a filename pattern must not cross directory boundaries.
query I
SELECT file FROM glob('abfss://{ABFSS_DATA_DIR}/**.csv') ORDER BY file;
----
abfss://{ABFSS_DATA_DIR}/l.csv
abfss://{ABFSS_DATA_DIR}/lineitem.csv

foreach pattern missing-directory/*.csv missing-directory/**/*.csv **/missing-file.csv

query I
SELECT count(*) FROM glob('abfss://{ABFSS_DATA_DIR}/{pattern}');
----
0

endloop
