# name: test/sql/cloud/azure_directory_scope_abfss.test
# description: a secret scoped to a directory ('<dir>/') is also used for operations on the directory path itself
# group: [cloud]

require azure

require-env ABFSS_STORAGE_ACCOUNT

require-env ABFSS_DATA_DIR

# Same as test/sql/azure_directory_scope.test, for abfss:// (DFS), where DirectoryExists is implemented by opening the
# path. A path '<container>/dir' (no trailing slash) used to miss a secret scoped to '<container>/dir/'.
#
# The secrets below fail while the client is created, so no request is sent and the error message shows which secret
# a path resolved to:
# - the secrets scoped to a directory or a prefix fail with 'invalid connection string'
# - the account wide secret fails with 'Unexpected end of Base64 encoded string'

statement ok
CREATE SECRET account_wide (
    TYPE AZURE,
    SCOPE 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/',
    CONNECTION_STRING 'AccountName={ABFSS_STORAGE_ACCOUNT};AccountKey=not-base64-!!!'
)

statement ok
CREATE SECRET dir_scope (
    TYPE AZURE,
    SCOPE 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/dir/',
    CONNECTION_STRING 'INVALID CONNECTION STRING'
)

statement ok
CREATE SECRET prefix_scope (
    TYPE AZURE,
    SCOPE 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/my-pa',
    CONNECTION_STRING 'INVALID CONNECTION STRING'
)

# The directory path itself, without the trailing slash, resolves to the secret scoped to '<dir>/'
statement error
COPY (SELECT 1 AS id) TO 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/dir' (FORMAT csv, PER_THREAD_OUTPUT);
----
invalid connection string

# Paths below the directory still resolve to it
statement error
COPY (SELECT 1 AS id) TO 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/dir/sub' (FORMAT csv, PER_THREAD_OUTPUT);
----
invalid connection string

# A sibling that only shares the prefix does not match a scope that ends in '/'
statement error
COPY (SELECT 1 AS id) TO 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/dir-other' (FORMAT csv, PER_THREAD_OUTPUT);
----
Unexpected end of Base64 encoded string

# A scope without a trailing slash stays a plain prefix match
statement error
COPY (SELECT 1 AS id) TO 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/my-path' (FORMAT csv, PER_THREAD_OUTPUT);
----
invalid connection string

statement error
COPY (SELECT 1 AS id) TO 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/my-pal' (FORMAT csv, PER_THREAD_OUTPUT);
----
invalid connection string

# A path outside every directory scope falls back to the account wide secret
statement error
COPY (SELECT 1 AS id) TO 'abfss://{ABFSS_STORAGE_ACCOUNT}.dfs.core.windows.net/{ABFSS_DATA_DIR}/directory_scope/elsewhere' (FORMAT csv, PER_THREAD_OUTPUT);
----
Unexpected end of Base64 encoded string

statement ok
DROP SECRET prefix_scope

statement ok
DROP SECRET dir_scope

statement ok
DROP SECRET account_wide
